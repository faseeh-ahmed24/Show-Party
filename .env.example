# ShowParty Configuration
# Copy this file to .env to customize settings.

# Port for the local Express + Socket.IO server
PORT=3000

# Private room access code required for guests joining via Cloudflare Tunnel or LAN.
# Leave empty to automatically generate a random 8-character code on startup.
ROOM_CODE=

# Maximum allowed MP4 upload size in megabytes (host-only uploads)
MAX_UPLOAD_MB=2048
